AUTH_URL=https://auth.latere.ai
AUTH_ALLOWED_PRINCIPALS=hi@changkun.de
AUTH_ALLOWED_CLIENTS=changkun-blog
# Lux gateway root, not a provider-compatible path such as .../anthropic.
LLM_BASE_URL=https://api.latere.ai/v1/models
# Lux Key from platform.latere.ai, scoped to the two models below.
LLM_API_KEY=
# Exact names from the gateway's catalog: GET $LLM_BASE_URL/lux/v1/models.
# LLM_MODEL writes the deep dive; LLM_TITLE_MODEL does everything else.
LLM_MODEL=anthropic/claude-opus-5.5
LLM_TITLE_MODEL=anthropic/claude-haiku-5.5
GIT_TOKEN=
GIT_REPO=changkun/blog
GIT_COMMITTER_NAME=Changkun Ideas API Server
GIT_COMMITTER_EMAIL=hi+ideas@changkun.de
# The library. A read-only key from zotero.org/settings/keys: library access
# only, notes and write off. In 1Password: op://Personal/Zotero/user-id and
# op://Personal/Zotero/api-key.
ZOTERO_USER_ID=
ZOTERO_API_KEY=
SYNC_INTERVAL=15m
